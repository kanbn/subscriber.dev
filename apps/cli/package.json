{
  "name": "@subscriber.dev/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "subscriber": "./dist/index.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc --watch --preserveWatchOutput",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@subscriber.dev/api-client": "workspace:*",
    "@subscriber.dev/shared": "workspace:^",
    "commander": "^15.0.0",
    "date-fns": "^4.4.0",
    "ink": "^8.0.0",
    "ink-select-input": "^6.2.0",
    "ink-text-input": "^6.0.0",
    "react": "catalog:react19"
  },
  "devDependencies": {
    "@subscriber.dev/eslint-config": "workspace:*",
    "@subscriber.dev/prettier-config": "workspace:*",
    "@subscriber.dev/tsconfig": "workspace:*",
    "@swc-node/register": "^1.12.1",
    "@types/node": "^22.20.5",
    "@types/react": "catalog:react19",
    "eslint": "catalog:",
    "ink-testing-library": "^4.0.0",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.1.6",
    "vitest": "^5.0.3"
  },
  "prettier": "@subscriber.dev/prettier-config"
}
