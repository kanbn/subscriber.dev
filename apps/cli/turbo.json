{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".cache/tsbuildinfo.json"]
    },
    "dev": {
      "dependsOn": [],
      "with": ["@subscriber.dev/api-client#dev"],
      "cache": false,
      "persistent": true
    }
  }
}
