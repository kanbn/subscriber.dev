    "/environments/{environmentId}/subscribers": {
      "get": {
        "operationId": "listSubscribers",
        "summary": "List subscribers",
        "description": "Returns a paginated list of active subscribers in the environment",
        "parameters": [
          {
            "name": "environmentId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "exclusiveMaximum": false,
              "exclusiveMinimum": false,
              "default": 20,
              "type": "number"
            }
          },
          {
            "name": "offset",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 0,
              "exclusiveMinimum": false,
              "default": 0,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListSubscribersResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Environment not found"
          }
        },
        "tags": [
          "Subscribers"
        ],
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "post": {
        "operationId": "createSubscriber",
        "summary": "Create a new subscriber",
        "description": "Creates a new subscriber in the specified environment and initialises their preferences",
        "parameters": [
          {
            "name": "environmentId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSubscriberDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Subscriber created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateSubscriberResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - validation error or duplicate subscriber"
          },
          "404": {
            "description": "Environment not found"
          }
        },
        "tags": [
          "Subscribers"
        ],
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
