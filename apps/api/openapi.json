    "/environments/{environmentId}/subscribers/bulk": {
      "post": {
        "operationId": "bulkUpsertSubscribers",
        "summary": "Bulk create or update subscribers",
        "description": "Upserts up to 500 subscribers per request. Each row is matched to an existing subscriber by publicId, then externalId, then email (in that order); if none match, a new subscriber is created. Rows are processed independently, so one failing row does not fail the batch.",
        "parameters": [
          {
            "name": "environmentId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkUpsertSubscribersDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkUpsertSubscribersResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Environment not found"
          }
        },
        "tags": [
          "Subscribers"
        ],
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/environments/{environmentId}/subscribers/{subscriberId}/preferences": {
      "patch": {
        "operationId": "updateSubscriberPreferences",
        "summary": "Update subscriber preferences",
        "description": "Creates a new preference record with updated values (immutable pattern)",
        "parameters": [
          {
            "name": "environmentId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
