    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Enter JWT token"
      },
      "api-key": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Enter API key"
      }
    },
    "schemas": {
      "TestResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          },
          "echo": {
            "type": "object",
            "properties": {
              "name": {
                "description": "Test name",
                "type": "string"
              },
              "message": {
                "description": "Optional message",
                "type": "string"
              }
            },
            "selfRequired": false
