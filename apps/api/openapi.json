              "id": {
                "type": "number"
              },
              "publicId": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "slug": {
                "type": "string"
              }
            },
            "selfRequired": true
          }
        },
        "required": [
          "workspace",
          "environment"
        ]
      },
      "CreateWorkspaceDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "required": [
          "name"
        ]
      },
      "CreateWorkspaceResponseDto": {
        "type": "object",
