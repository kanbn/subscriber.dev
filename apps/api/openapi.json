                "type": "number"
              },
              "publicId": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "slug": {
                "type": "string"
              }
            },
            "selfRequired": true
          },
          "environment": {
            "type": "object",
            "properties": {
              "id": {
                "type": "number"
              },
              "publicId": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "slug": {
                "type": "string"
              }
            },
            "selfRequired": true
          }
        },
        "required": [
          "workspace",
          "environment"
        ]
      },
      "CreateSubscriberDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
