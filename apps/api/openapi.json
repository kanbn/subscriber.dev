        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePreferencesDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Preferences updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdatePreferencesResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Subscriber or preferences not found"
          }
        },
        "tags": [
          "Subscribers"
        ],
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/unsubscribe": {
      "get": {
        "operationId": "unsubscribe",
        "summary": "Unsubscribe via email link",
        "description": "Public endpoint for one-click unsubscribe links embedded in emails. Verifies the signed token and turns off email notifications for the subscriber it identifies. No API key required.",
        "parameters": [
          {
            "name": "token",
            "required": true,
            "in": "query",
            "schema": {
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
