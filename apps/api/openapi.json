              },
              "attributes": {
                "type": "object",
                "additionalProperties": {},
                "nullable": true
              },
              "createdAt": {},
              "updatedAt": {}
            },
            "selfRequired": true
          },
          "preferences": {
            "type": "object",
            "properties": {
              "id": {
                "type": "number"
              },
              "subscriberId": {
                "type": "number"
              },
              "email": {
                "type": "boolean"
