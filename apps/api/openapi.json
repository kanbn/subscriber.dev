      },
      "TestRequestDto": {
        "type": "object",
        "properties": {
          "name": {
            "description": "Test name",
            "type": "string"
          },
          "message": {
            "description": "Optional message",
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "GetWorkspaceResponseDto": {
        "type": "object",
        "properties": {
          "workspace": {
            "type": "object",
            "properties": {
              "id": {
                "type": "number"
              },
              "publicId": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "slug": {
                "type": "string"
              }
            },
            "selfRequired": true
          },
          "environment": {
            "type": "object",
