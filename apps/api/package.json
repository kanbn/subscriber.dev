{
  "name": "@subscriber.dev/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "pnpm with-env node --import @swc-node/register/esm-register src/main.ts",
    "dev:watch": "pnpm with-env node --watch --import @swc-node/register/esm-register src/main.ts",
    "start": "pnpm with-env node dist/main.js",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "with-env": "dotenv -e ../../.env --",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.802.0",
    "@aws-sdk/s3-request-presigner": "^3.812.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/swagger": "^7.4.2",
    "@subscriber.dev/auth": "workspace:*",
    "@subscriber.dev/db": "workspace:*",
    "@subscriber.dev/email": "workspace:^",
    "@subscriber.dev/shared": "workspace:^",
    "@subscriber.dev/stripe": "workspace:^",
    "bullmq": "^5.81.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "drizzle-orm": "^0.42.0",
    "html-to-text": "^10.0.0",
    "ioredis": "^5.11.1",
    "liquidjs": "^10.28.0",
    "nestjs-zod": "^5.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.19",
    "@subscriber.dev/eslint-config": "workspace:*",
    "@subscriber.dev/prettier-config": "workspace:*",
    "@subscriber.dev/tsconfig": "workspace:*",
    "@swc-node/register": "^1.10.9",
    "@swc/core": "^1.7.26",
    "@types/express": "^5.0.6",
    "@types/html-to-text": "^9.0.4",
    "dotenv-cli": "^7.4.4",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "^1.5.9",
    "vitest": "^2.1.9"
  },
  "prettier": "@subscriber.dev/prettier-config"
}
