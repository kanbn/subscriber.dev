{
  "name": "@subscriber.dev/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "pnpm with-env node --watch --import @swc-node/register/esm-register src/main.ts",
    "start": "pnpm with-env node dist/main.js",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "openapi": "node --import @swc-node/register/esm-register src/openapi.generate.ts",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "with-env": "dotenv -e ../../.env --",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@rekog/mcp-nest": "^1.9.11",
    "@subscriber.dev/auth": "workspace:*",
    "@subscriber.dev/db": "workspace:*",
    "@subscriber.dev/email": "workspace:^",
    "@subscriber.dev/shared": "workspace:^",
    "@subscriber.dev/stripe": "workspace:^",
    "aws4fetch": "^1.0.20",
    "bullmq": "^6.3.11",
    "drizzle-orm": "^0.45.3",
    "html-to-text": "^10.0.1",
    "ioredis": "^6.0.0",
    "liquidjs": "^10.30.0",
    "nestjs-zod": "^5.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@subscriber.dev/eslint-config": "workspace:*",
    "@subscriber.dev/prettier-config": "workspace:*",
    "@subscriber.dev/tsconfig": "workspace:*",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.13",
    "@types/express": "^5.0.6",
    "@types/html-to-text": "^9.0.4",
    "dotenv-cli": "^11.0.0",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "prettier": "@subscriber.dev/prettier-config"
}
