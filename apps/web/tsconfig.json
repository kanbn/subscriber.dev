{
  "extends": "@subscriber.dev/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ES2022", "dom", "dom.iterable"],
    "jsx": "preserve",
    "paths": {
      "~/*": ["./src/*"]
    },
    "plugins": [{ "name": "next" }],
    "module": "esnext",
    "noUncheckedSideEffectImports": false
  },
  "include": [".", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
