{
  "name": "@subscriber.dev/email",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.tsx"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "GPL-3.0",
  "scripts": {
    "dev": "tsc",
    "run:dev": "email dev --dir src/templates",
    "export": "email export",
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "juice": "^12.2.0",
    "next-runtime-env": "^1.8.0",
    "nodemailer": "^10.0.16",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "react-email": "^6.11.1"
  },
  "devDependencies": {
    "@subscriber.dev/eslint-config": "workspace:*",
    "@subscriber.dev/prettier-config": "workspace:*",
    "@subscriber.dev/tsconfig": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "catalog:react19",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@subscriber.dev/prettier-config"
}
