{
  "name": "@subscriber.dev/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./hooks": {
      "types": "./dist/generated.d.ts",
      "import": "./dist/generated.js",
      "default": "./src/generated.ts"
    },
    "./cli": {
      "types": "./dist/generated-cli.d.ts",
      "import": "./dist/generated-cli.js",
      "default": "./src/generated-cli.ts"
    },
    "./root": {
      "types": "./dist/root.d.ts",
      "default": "./src/root.ts"
    },
    "./trpc": {
      "types": "./dist/trpc.d.ts",
      "default": "./src/trpc.ts"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./src/types/router.types.ts"
    },
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "default": "./src/openapi.ts"
    }
  },
  "license": "GPL-3.0",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "orval --watch & tsc --watch --preserveWatchOutput",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "generate": "orval"
  },
  "dependencies": {
    "@subscriber.dev/shared": "workspace:^",
    "@tanstack/react-query": "catalog:",
    "next-runtime-env": "^1.7.2"
  },
  "devDependencies": {
    "@subscriber.dev/eslint-config": "workspace:*",
    "@subscriber.dev/prettier-config": "workspace:*",
    "@subscriber.dev/tsconfig": "workspace:*",
    "dotenv": "^16.0.0",
    "eslint": "catalog:",
    "orval": "^7.17.2",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@subscriber.dev/prettier-config"
}
