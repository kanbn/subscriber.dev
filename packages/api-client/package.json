{
  "name": "@subscriber.dev/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./hooks": {
      "types": "./dist/generated.d.ts",
      "default": "./src/generated.ts"
    },
    "./root": {
      "types": "./dist/root.d.ts",
      "default": "./src/root.ts"
    },
    "./trpc": {
      "types": "./dist/trpc.d.ts",
      "default": "./src/trpc.ts"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./src/types/router.types.ts"
    },
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "default": "./src/openapi.ts"
    }
  },
  "license": "GPL-3.0",
  "scripts": {
    "build": "orval && tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "orval --watch & tsc --watch --preserveWatchOutput",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "generate": "orval"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.802.0",
    "@aws-sdk/s3-request-presigner": "^3.812.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@subscriber.dev/auth": "workspace:*",
    "@subscriber.dev/db": "workspace:*",
    "@subscriber.dev/email": "workspace:^",
    "@subscriber.dev/shared": "workspace:^",
    "@subscriber.dev/stripe": "workspace:^",
    "@tanstack/react-query": "catalog:",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@subscriber.dev/eslint-config": "workspace:*",
    "@subscriber.dev/prettier-config": "workspace:*",
    "@subscriber.dev/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "orval": "^7.17.2",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@subscriber.dev/prettier-config"
}
