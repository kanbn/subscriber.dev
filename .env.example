# Required environment variables
NEXT_PUBLIC_BASE_URL= # e.g. https://subscriber.dev
NEXT_PUBLIC_API_BASE_URL= # e.g. https://api.subscriber.dev
BETTER_AUTH_SECRET= # Random 32+ char string (can gen with: openssl rand -base64 24 | tr -dc 'a-zA-Z0-9' | head -c 32)
EMAIL_UNSUBSCRIBE_SECRET= # Random 32+ char string, signs unsubscribe links (can gen the same way)

# Fill if you want to use an external database
POSTGRES_URL= # e.g. postgresql://subscriber:your_password@your_host:5432/subscriber

# Only required if deploying from compose
POSTGRES_PASSWORD=

# Redis (required by the API for workflow scheduling/BullMQ)
REDIS_HOST= # e.g. 127.0.0.1 for local dev; defaults to "redis" when deployed via compose
REDIS_PASSWORD= # Random 32+ char string (can gen the same way as the secrets above). Also used by the compose redis service's --requirepass, so it only needs to be set once.

# Required if any environment configures an integration (e.g. SMTP) via the API - encrypts credentials at rest.
# Generate with: openssl rand -base64 32
INTEGRATIONS_ENCRYPTION_KEY=

# Only required if deploying from compose
REDIS_PORT=

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM= # e.g. "Acme <hello@mail.acme.com>"
SMTP_SECURE= # set to "false" to use port 587
SMTP_REJECT_UNAUTHORIZED= # set to "false" to accept invalid certs

# GitHub sign-in (optional)
BETTER_AUTH_TRUSTED_ORIGINS=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

BILLING_ENABLED=
STRIPE_BILLING_WEBHOOK_SECRET=
